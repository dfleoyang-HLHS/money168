  "keyIndicators": [
    {
      "id": "ism",
      "name": {
        "en": "ISM Manufacturing PMI",
        "zh": "ISM 製造業採購經理人指數"
      },
      "role": "growth_momentum",
      "priority": 1,
      "dataFile": "series/ism.json",
      "frequency": "monthly",
      "thresholds": {
        "contraction": 50,
        "neutralLow": 50,
        "neutralHigh": 52,
        "strong": 55,
        "veryStrong": 58
      },
      "interpretation": {
        "level": {
          "below_50": {
            "zh": "製造業活動收縮，通常對應疲弱景氣。",
            "en": "Manufacturing contraction; typically weak activity."
          },
          "above_50": {
            "zh": "製造業活動擴張。",
            "en": "Manufacturing expansion."
          }
        },
        "momentum": {
          "inflecting_up_from_low": {
            "zh": "書中強調的最佳組合：疲弱但開始回升。",
            "en": "Book highlight: weak but inflecting upward."
          },
          "deteriorating_from_high": {
            "zh": "高位但惡化，常見於周期末端。",
            "en": "High but deteriorating; often late-cycle."
          }
        }
      },
      "preferredPhases": ["hope", "growth"],
      "cautionPhases": ["despair", "optimism"]
    },
    {
      "id": "cpi",
      "name": {
        "en": "Consumer Price Index (YoY)",
        "zh": "消費者物價指數（年增率）"
      },
      "role": "inflation_policy",
      "priority": 2,
      "dataFile": "series/cpi.json",
      "frequency": "monthly",
      "thresholds": {
        "veryLow": 1.0,
        "target": 2.0,
        "moderate": 3.0,
        "elevated": 4.0,
        "high": 5.0
      },
      "interpretation": {
        "level": {
          "low": {
            "zh": "低通膨環境，有利估值與政策空間。",
            "en": "Low inflation supports valuations and policy flexibility."
          },
          "elevated": {
            "zh": "高通膨提高緊縮風險，壓制風險資產。",
            "en": "High inflation raises tightening risk and pressures risk assets."
          }
        },
        "momentum": {
          "falling": {
            "zh": "通膨回落常伴隨政策轉向預期。",
            "en": "Disinflation often precedes policy pivot expectations."
          },
          "reaccelerating": {
            "zh": "通膨再升通常提高利率與波動。",
            "en": "Reaccelerating inflation tends to lift rates and volatility."
          }
        }
      },
      "preferredPhases": ["hope", "growth"],
      "cautionPhases": ["despair", "optimism"]
    }
  ],
  "auxiliaryIndicators": [
    {
      "id": "sp500_pe",
